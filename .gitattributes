# Line endings are part of the content here: the showcase generator (`oxshowcase_generate --check`) compares what it
# writes byte for byte with the committed JSON/Lua/material files, asset metas store content hashes, and golden / text
# test data is compared verbatim. Text is therefore LF in the repository AND in every working tree, whatever
# core.autocrlf says (Git for Windows enables it system-wide).
* text=auto eol=lf

# --- Source, build system, scripts
*.c             text eol=lf
*.h             text eol=lf
*.cpp           text eol=lf
*.hpp           text eol=lf
*.mm            text eol=lf
*.cmake         text eol=lf
*.cmake.in      text eol=lf
CMakeLists.txt  text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.sh            text eol=lf
*.lua           text eol=lf
*.qss           text eol=lf
*.supp          text eol=lf

# Windows command scripts need CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf

# --- Shaders
*.glsl          text eol=lf
*.vert          text eol=lf
*.frag          text eol=lf
*.comp          text eol=lf
*.tesc          text eol=lf
*.tese          text eol=lf
*.mesh          text eol=lf
*.task          text eol=lf
*.rgen          text eol=lf
*.rchit         text eol=lf
*.rahit         text eol=lf
*.rmiss         text eol=lf

