# binary -> JSON file -> binary through the CLI must reproduce the input byte for byte.
file(MAKE_DIRECTORY ${WORK_DIR})
execute_process(COMMAND ${OXDUMP} ${INPUT} -o ${WORK_DIR}/scene.json RESULT_VARIABLE r1)
if(NOT r1 EQUAL 0)
    message(FATAL_ERROR "oxdump to JSON failed: ${r1}")
endif()
execute_process(COMMAND ${OXDUMP} --to-binary ${WORK_DIR}/scene.json ${WORK_DIR}/scene.oxscene RESULT_VARIABLE r2)
if(NOT r2 EQUAL 0)
    message(FATAL_ERROR "oxdump --to-binary failed: ${r2}")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${INPUT} ${WORK_DIR}/scene.oxscene RESULT_VARIABLE r3)
if(NOT r3 EQUAL 0)
    message(FATAL_ERROR "round trip is not byte-identical")
endif()
