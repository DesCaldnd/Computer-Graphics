<rml>
<head>
    <title>Main menu</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body class="menu">
    <div class="panel">
        <div class="title">OXWALD</div>
        <div class="subtitle">Showcase · Демонстрация движка</div>
