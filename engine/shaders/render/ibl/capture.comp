#version 460
// Environment capture: sky radiance (or the HDRI cubemap) into mip 0 of the environment cube (rgba16f).
#include <render/common/sky.glsl>
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
OX_RENDER_PUSH(uint dst; uint size;);
void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= pc.size || id.y >= pc.size) return;
    vec2 uv = (vec2(id.xy) + 0.5) / float(pc.size);
    vec3 dir = oxCubeDirection(id.z, uv);
    vec3 c = oxSkyRadiance(pc.view, pc.scene, dir, false);
    imageStore(oxImages2DArray_rgba16f[nonuniformEXT(pc.dst)], ivec3(id), vec4(min(c, vec3(60000.0)), 1.0));
}
