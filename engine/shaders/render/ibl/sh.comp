#version 460
// Projects the environment cube (a small mip) onto SH9 and stores coefficients pre-convolved with the clamped
// cosine lobe divided by π (oxEvalSH9 then returns the diffuse radiance of a white Lambertian surface).
#include <render/common/math.glsl>
#include <common/bindless.glsl>
layout(local_size_x = 128) in;
OX_BUFFER(SHOut, { vec4 c[9]; });
OX_PUSH_CONSTANTS({ SHOut dst; uint src; uint size; float lod; });

shared vec3 sSH[128][9];
shared float sWeight[128];

void main() {
    uint t = gl_LocalInvocationID.x;
    vec3 acc[9];
    for (int k = 0; k < 9; ++k) acc[k] = vec3(0.0);
    float wsum = 0.0;
    uint texels = pc.size * pc.size * 6u;
    for (uint i = t; i < texels; i += 128u) {
        uint face = i / (pc.size * pc.size);
        uint rem = i % (pc.size * pc.size);
        vec2 uv = (vec2(rem % pc.size, rem / pc.size) + 0.5) / float(pc.size);
        vec2 p = uv * 2.0 - 1.0;
        float w = 1.0 / pow(1.0 + dot(p, p), 1.5); // solid angle ∝
        vec3 n = oxCubeDirection(face, uv);
        vec3 c = textureLod(samplerCube(OX_TEXCUBE(pc.src), OX_SAMPLER(OX_SAMPLER_LINEAR_CLAMP)), n, pc.lod).rgb * w;
        acc[0] += c * 0.282095;
        acc[1] += c * 0.488603 * n.y;
        acc[2] += c * 0.488603 * n.z;
        acc[3] += c * 0.488603 * n.x;
        acc[4] += c * 1.092548 * n.x * n.y;
        acc[5] += c * 1.092548 * n.y * n.z;
        acc[6] += c * 0.315392 * (3.0 * n.z * n.z - 1.0);
        acc[7] += c * 1.092548 * n.x * n.z;
        acc[8] += c * 0.546274 * (n.x * n.x - n.y * n.y);
        wsum += w;
    }
    for (int k = 0; k < 9; ++k) sSH[t][k] = acc[k];
    sWeight[t] = wsum;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) {
        if (t < s) {
            for (int k = 0; k < 9; ++k) sSH[t][k] += sSH[t + s][k];
            sWeight[t] += sWeight[t + s];
        }
        barrier();
    }
    if (t == 0u) {
        float norm = 4.0 * OX_PI / sWeight[0];
        // Cosine-lobe convolution Â_l = (π, 2π/3, π/4), then / π.
        const float band[9] = float[](1.0, 2.0 / 3.0, 2.0 / 3.0, 2.0 / 3.0, 0.25, 0.25, 0.25, 0.25, 0.25);
        for (int k = 0; k < 9; ++k) pc.dst.c[k] = vec4(sSH[0][k] * norm * band[k], 0.0);
    }
}
