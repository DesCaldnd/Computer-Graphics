#version 460
// Volumetrics noise generation (once at startup, tileable in every axis):
//   mode 0  base shape 3D RGBA8: r = Perlin-Worley, g/b/a = Worley FBM at increasing frequency (cloud shapes, fog)
//   mode 1  detail 3D RGBA8: r/g/b = Worley FBM at increasing frequency (cloud edge erosion)
//   mode 2  weather 2D RGBA8: r = coverage FBM, g = cloud type variation
#include <render/volumetrics/volumetrics_types.glsl>

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

OX_PUSH_CONSTANTS({ uint target; uint size; uint mode; uint seed; });

uvec3 pcg3d(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v;
}

vec3 hash33(ivec3 p) { return vec3(pcg3d(uvec3(p) + uvec3(pc.seed, pc.seed * 7u, pc.seed * 13u))) * (1.0 / 4294967295.0); }

// Callers pass lattice cells from -1 upwards. GLSL leaves % undefined for negative operands (on NVIDIA the cell -1
// did not wrap to period - 1, which put seams into the weather map), so the offset is added first.
ivec3 wrap(ivec3 p, int period) { return (p + period) % period; }

// Tileable gradient noise in [-1, 1] (period in lattice cells).
float perlin(vec3 p, int period) {
    ivec3 i = ivec3(floor(p));
    vec3 f = fract(p);
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float n[8];
    for (int k = 0; k < 8; ++k) {
        ivec3 o = ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
        vec3 g = normalize(hash33(wrap(i + o, period)) * 2.0 - 1.0 + 1e-4);
        n[k] = dot(g, f - vec3(o));
    }
    float x0 = mix(mix(n[0], n[1], u.x), mix(n[2], n[3], u.x), u.y);
    float x1 = mix(mix(n[4], n[5], u.x), mix(n[6], n[7], u.x), u.y);
    return mix(x0, x1, u.z) * 1.6;
}

float perlinFbm(vec3 uvw, int period, int octaves) {
    float sum = 0.0, amp = 1.0, norm = 0.0;
    for (int o = 0; o < octaves; ++o) {
        sum += perlin(uvw * float(period), period) * amp;
        norm += amp;
        amp *= 0.5;
        period *= 2;
    }
    return sum / norm;
}

// Tileable cellular noise, inverted (1 at the feature points, 0 far away).
float worley(vec3 uvw, int cells) {
    vec3 p = uvw * float(cells);
    ivec3 i = ivec3(floor(p));
    vec3 f = fract(p);
    float minD = 1e9;
    for (int z = -1; z <= 1; ++z)
        for (int y = -1; y <= 1; ++y)
            for (int x = -1; x <= 1; ++x) {
                ivec3 o = ivec3(x, y, z);
                vec3 d = vec3(o) + hash33(wrap(i + o, cells) + ivec3(cells * 1031)) - f;
                minD = min(minD, dot(d, d));
            }
    return 1.0 - clamp(sqrt(minD), 0.0, 1.0);
}

float worleyFbm(vec3 uvw, int cells) {
    return worley(uvw, cells) * 0.625 + worley(uvw, cells * 2) * 0.25 + worley(uvw, cells * 4) * 0.125;
}

float remap01(float v, float lo, float hi) { return clamp((v - lo) / max(hi - lo, 1e-5), 0.0, 1.0); }

// The raw FBMs are narrow (sd ≈ 0.06-0.12 around their mean): stretch ±2 sd to [0, 1] so the density functions
// get usable contrast (means / sds measured on the generated volumes).
float stretch(float v, float mean, float sd) { return clamp((v - mean) / (4.0 * sd) + 0.5, 0.0, 1.0); }
float worleyN(vec3 uvw, int cells) { return stretch(worleyFbm(uvw, cells), 0.48, 0.12); }

void main() {
    uvec3 c = gl_GlobalInvocationID;
    uint depth = pc.mode == 2u ? 1u : pc.size;
    if (any(greaterThanEqual(c, uvec3(pc.size, pc.size, depth)))) return;
    vec3 uvw = (vec3(c) + 0.5) / float(pc.size);
    if (pc.mode == 0u) {
        float p = perlinFbm(uvw, 4, 6) * 0.5 + 0.5;
        float w = worleyFbm(uvw, 4);
        float pw = remap01(p, w - 1.0, 1.0); // Perlin-Worley: billowy Perlin with Worley cells carved in
        vec4 v = vec4(stretch(pw, 0.67, 0.063), stretch(w, 0.48, 0.12), worleyN(uvw, 8), worleyN(uvw, 16));
        imageStore(oxVolImages3D_rgba8[nonuniformEXT(pc.target)], ivec3(c), v);
    } else if (pc.mode == 1u) {
        vec4 v = vec4(worleyN(uvw, 4), worleyN(uvw, 8), worleyN(uvw, 16), 1.0);
        imageStore(oxVolImages3D_rgba8[nonuniformEXT(pc.target)], ivec3(c), v);
    } else {
        vec3 p2 = vec3(uvw.xy, 0.37);
        float coverage = (perlinFbm(p2, 4, 5) * 0.5 + 0.5) * 0.7 + worleyFbm(p2, 6) * 0.3;
        float type = perlinFbm(p2 + 0.5, 2, 3) * 0.5 + 0.5;
        imageStore(oxImages2D_rgba8[nonuniformEXT(pc.target)], ivec2(c.xy),
                   vec4(stretch(coverage, 0.507, 0.069), stretch(type, 0.5, 0.08), 0.0, 1.0));
    }
}
