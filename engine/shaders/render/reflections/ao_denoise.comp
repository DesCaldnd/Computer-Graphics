#version 460
// AO spatial denoise: 3×3 depth- and normal-aware (cross bilateral) filter at AO resolution (the temporal pass does
// the rest).
#include <render/common/scene.glsl>

layout(local_size_x = 8, local_size_y = 8) in;

OX_RENDER_PUSH(uint src; uint depth; uint normals; uint dst; uint downscale; uint aoWidth; uint aoHeight;);

float linAt(ivec2 ap, out vec3 n) {
    ivec2 size = ivec2(VIEW.renderSize.xy);
    ivec2 p = min(ap * int(pc.downscale) + int(pc.downscale) / 2, size - 1);
    n = OX_FETCH_2D(pc.normals, p, 0).xyz;
    float d = OX_FETCH_2D(pc.depth, p, 0).r;
    return d > 0.0 ? oxLinearDepth(pc.view, d) : 1e6;
}

void main() {
    ivec2 ap = ivec2(gl_GlobalInvocationID.xy);
    ivec2 aoSize = ivec2(pc.aoWidth, pc.aoHeight);
    if (ap.x >= aoSize.x || ap.y >= aoSize.y) return;
    vec3 n0;
    float z0 = linAt(ap, n0);
    float sum = 0.0, wsum = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(ap + ivec2(x, y), ivec2(0), aoSize - 1);
            vec3 n;
            float z = linAt(q, n);
            float wd = exp(-abs(z - z0) / max(z0 * 0.02, 1e-3));
            float wn = pow(clamp(dot(n, n0), 0.0, 1.0), 8.0);
            float ws = (x == 0 && y == 0) ? 1.0 : (x == 0 || y == 0 ? 0.75 : 0.5);
            float w = wd * wn * ws + 1e-5 * float(x == 0 && y == 0);
            sum += OX_FETCH_2D(pc.src, q, 0).r * w;
            wsum += w;
        }
    }
    OX_IMAGE_STORE_2D(r16f, pc.dst, ap, vec4(sum / max(wsum, 1e-5)));
}
