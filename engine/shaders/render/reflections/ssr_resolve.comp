#version 460
// SSR spatial resolve (Stachowiak 2015): every full-resolution pixel reuses the hits of neighbouring trace pixels,
// weighting each by its own BRDF / the sampling pdf of the neighbour (ratio estimator), and fetches the hit
// radiance from the previous frame's colour pyramid (reprojected with the hit's motion vector) at a mip matching
// the reflection cone footprint. Output RGBA16F: rgb radiance (not pre-exposed), a = confidence.
#include <render/reflections/ssr_common.glsl>
#include <render/common/scene.glsl>

layout(local_size_x = 8, local_size_y = 8) in;

OX_RENDER_PUSH(uint depth; uint normals; uint velocity; uint hits; uint color; uint colorMips; uint outResolve;
               uint downscale; uint sampleCount; float maxRoughness; uint traceWidth; uint traceHeight;);

const ivec2 kOffsets[8] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1), ivec2(-1, 0), ivec2(0, -1),
                                  ivec2(-1, -1), ivec2(-1, 1));

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(VIEW.renderSize.xy);
    if (p.x >= size.x || p.y >= size.y) return;
    float d = OX_FETCH_2D(pc.depth, p, 0).r;
    vec4 nr = OX_FETCH_2D(pc.normals, p, 0);
    float rough = clamp(nr.w, OX_MIN_PERCEPTUAL_ROUGHNESS, 1.0);
    if (d <= 0.0 || rough > pc.maxRoughness) {
        OX_IMAGE_STORE_2D(rgba16f, pc.outResolve, p, vec4(0.0));
        return;
    }
    vec2 uv = (vec2(p) + 0.5) * VIEW.renderSize.zw;
    vec3 P = oxWorldPositionFromDepth(pc.view, uv, d);
    vec3 N = normalize(nr.xyz);
    vec3 camPos = VIEW.cameraPosition.xyz;
    vec3 V = (VIEW.flags & OX_VIEW_ORTHOGRAPHIC) != 0u ? normalize(VIEW.invView[2].xyz) : normalize(camPos - P);
    float a = rough * rough;
    float NdotV = max(dot(N, V), 1e-4);
    bool mirror = rough < 0.05;
    float focalPx = abs(VIEW.proj[1][1]) * VIEW.renderSize.y * 0.5;
    float coneTan = a * 0.6;

    ivec2 tp = p / int(pc.downscale);
    ivec2 tmax = ivec2(pc.traceWidth, pc.traceHeight) - 1;
    // Rotate the neighbourhood per pixel/frame to decorrelate the reuse pattern.
    uint rot = (uint(p.x) * 3u + uint(p.y) * 5u + VIEW.frameIndex) & 3u;
    uint count = mirror ? 1u : pc.sampleCount;

    vec3 colorSum = vec3(0.0);
    float weightSum = 0.0;
    float confSum = 0.0;
    for (uint k = 0u; k < count; ++k) {
        ivec2 o = kOffsets[k];
        if (k > 0u) {
            for (uint r = 0u; r < rot; ++r) o = ivec2(-o.y, o.x);
        }
        ivec2 tc = clamp(tp + o, ivec2(0), tmax);
        vec4 s = OX_FETCH_2D(pc.hits, tc, 0);
        if (s.w <= 0.0) continue;
        vec2 hitUv = s.xy;
        ivec2 hitPx = clamp(ivec2(hitUv * VIEW.renderSize.xy), ivec2(0), size - 1);
        float hd = OX_FETCH_2D(pc.depth, hitPx, 0).r;
        if (hd <= 0.0) continue;
        vec3 H = oxWorldPositionFromDepth(pc.view, hitUv, hd);
        vec3 toHit = H - P;
        float hitDist = length(toHit);
        vec3 L = toHit / max(hitDist, 1e-5);
        float NdotL = dot(N, L);
        if (NdotL <= 0.0) continue;
        float w = 1.0;
        if (!mirror) {
            vec3 h = normalize(V + L);
            float NdotH = clamp(dot(N, h), 0.0, 1.0);
            w = oxDGGX(NdotH, a) * oxVSmithGGXCorrelated(NdotV, NdotL, a) * NdotL / max(s.z, 1e-4);
        }
        vec2 vel = OX_SAMPLE_2D_LOD(pc.velocity, OX_SAMPLER_NEAREST_CLAMP, hitUv, 0.0).xy;
        vec2 prevUv = hitUv - vel;
        if (any(lessThan(prevUv, vec2(0.0))) || any(greaterThan(prevUv, vec2(1.0)))) continue;
        float hitLin = oxLinearDepth(pc.view, hd);
        float footprint = hitDist * coneTan * focalPx / max(hitLin, 1e-3);
        float mip = clamp(log2(max(footprint, 1.0)), 0.0, float(pc.colorMips) - 1.0);
        vec3 c = OX_SAMPLE_2D_LOD(pc.color, OX_SAMPLER_LINEAR_CLAMP, prevUv, mip).rgb;
        c *= 1.0 / (1.0 + oxLuminance(c) * VIEW.exposure); // firefly suppression (tonemapped weighting)
        float cw = w * s.w;
        colorSum += c * cw;
        weightSum += cw;
        confSum += s.w;
    }
    vec3 color = weightSum > 0.0 ? colorSum / weightSum : vec3(0.0);
    color *= 1.0 / max(1.0 - oxLuminance(color) * VIEW.exposure, 1e-3); // undo the weighting
    float conf = confSum / float(count);
    OX_IMAGE_STORE_2D(rgba16f, pc.outResolve, p, vec4(color, clamp(conf, 0.0, 1.0)));
}
