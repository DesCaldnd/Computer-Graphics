#version 460
// SSR source colour: mip 0 = SceneColorHDR / preExposure (absolute radiance, so next frame's lookups are exposure
// independent), mip n = 2×2 box of mip n-1 (cone-traced blur for rough reflections).
#include <render/common/scene.glsl>
layout(local_size_x = 8, local_size_y = 8) in;
OX_RENDER_PUSH(uint src; uint dst; uvec2 srcSize; uvec2 dstSize; uint fromScene;);
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, pc.dstSize))) return;
    vec4 c;
    if (pc.fromScene != 0u) {
        c = vec4(OX_FETCH_2D(pc.src, ivec2(p), 0).rgb / max(VIEW.preExposure, 1e-30), 1.0);
        c.rgb = min(c.rgb, vec3(60000.0));
    } else {
        ivec2 s = ivec2(p * 2u);
        ivec2 m = ivec2(pc.srcSize) - 1;
        c = (OX_IMAGE_LOAD_2D(rgba16f, pc.src, min(s, m)) + OX_IMAGE_LOAD_2D(rgba16f, pc.src, min(s + ivec2(1, 0), m)) +
             OX_IMAGE_LOAD_2D(rgba16f, pc.src, min(s + ivec2(0, 1), m)) + OX_IMAGE_LOAD_2D(rgba16f, pc.src, min(s + ivec2(1, 1), m))) * 0.25;
    }
    OX_IMAGE_STORE_2D(rgba16f, pc.dst, ivec2(p), c);
}
