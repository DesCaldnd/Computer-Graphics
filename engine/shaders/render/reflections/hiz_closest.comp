#version 460
// HiZClosest pyramid: mip 0 = depth, mip n = max of the 2×2 (3×3 at odd edges) footprint of mip n-1 (reversed-Z
// max = nearest surface → conservative empty-space skipping for screen-space ray marching).
#include <render/common/view.glsl>
layout(local_size_x = 8, local_size_y = 8) in;
OX_PUSH_CONSTANTS({ uint src; uint dst; uvec2 srcSize; uvec2 dstSize; uint fromDepth; });
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, pc.dstSize))) return;
    if (pc.fromDepth != 0u) {
        float d = OX_FETCH_2D(pc.src, ivec2(p), 0).r;
        OX_IMAGE_STORE_2D(r32f, pc.dst, ivec2(p), vec4(d));
        return;
    }
    ivec2 s = ivec2(p * 2u);
    ivec2 maxS = ivec2(pc.srcSize) - 1;
    float m = 0.0;
    int ex = (pc.srcSize.x & 1u) != 0u && p.x == pc.dstSize.x - 1u ? 2 : 1;
    int ey = (pc.srcSize.y & 1u) != 0u && p.y == pc.dstSize.y - 1u ? 2 : 1;
    for (int y = 0; y <= ey; ++y)
        for (int x = 0; x <= ex; ++x) m = max(m, OX_IMAGE_LOAD_2D(r32f, pc.src, min(s + ivec2(x, y), maxS)).r);
    OX_IMAGE_STORE_2D(r32f, pc.dst, ivec2(p), vec4(m));
}
