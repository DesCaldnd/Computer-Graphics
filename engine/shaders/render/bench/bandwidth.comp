#version 460
#include <common/bindless.glsl>
layout(local_size_x = 256) in;
OX_READONLY_BUFFER(Src, { vec4 v[]; });
OX_BUFFER(Dst, { vec4 v[]; });
OX_PUSH_CONSTANTS({ Src src; Dst dst; uint count; });
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.count) pc.dst.v[i] = pc.src.v[i] * 1.0001;
}
