#version 460
// Ray traced reflections (ReflectionsRT → ReflectionsSpecular): per pixel `spp` rays sampled from the GGX visible
// normal distribution of the G-buffer roughness, one bounce with simple hit lighting (sun + one local light with
// shadow rays, emissive, DDGI / SH diffuse, prefiltered specular), sky on miss. Above `maxRoughness` the weight fades
// to 0 so the forward pass keeps the probe / IBL result. Output: rgb radiance (not pre-exposed), a = weight.
#include "rt_query.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

OX_RENDER_PUSH(RtSceneBuffer rt; uint depth; uint normals; uint outRefl; uint width; uint height; uint scale;
               uint frame; uint spp; float maxRoughness; uint flags;);

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.width, pc.height)))) return;
    ivec2 renderSize = ivec2(VIEW.renderSize.xy);
    ivec2 gp = clamp(p * int(pc.scale) + int(pc.scale / 2u), ivec2(0), renderSize - 1);
    float d = OX_FETCH_2D(pc.depth, gp, 0).r;
    vec4 nr = OX_FETCH_2D(pc.normals, gp, 0);
    float roughness = clamp(nr.w, OX_MIN_PERCEPTUAL_ROUGHNESS, 1.0);
    if (d <= 0.0 || roughness > pc.maxRoughness) {
        OX_IMAGE_STORE_2D(rgba16f, pc.outRefl, p, vec4(0.0));
        return;
    }
    vec2 uv = (vec2(gp) + 0.5) * VIEW.renderSize.zw;
    vec3 P = oxWorldPositionFromDepth(pc.view, uv, d);
    vec3 N = normalize(nr.xyz);
    vec3 V = (VIEW.flags & OX_VIEW_ORTHOGRAPHIC) != 0u ? normalize(VIEW.invView[2].xyz)
                                                      : normalize(VIEW.cameraPosition.xyz - P);
    if (dot(N, V) < 0.0) N = reflect(N, V); // normal-mapped grazing normals
    vec3 origin = P + N * max(1e-3 * length(VIEW.cameraPosition.xyz - P), 2e-3);
    float alpha = roughness * roughness;
    uint rng = oxRtSeed(uvec2(p), pc.frame, 0x4EF1u);
    vec3 Vl = oxToLocal(V, N);
    vec3 sum = vec3(0.0);
    // Firefly clamp: radiance that would exceed ~16× display white after exposure.
    float maxLum = 16.0 / max(VIEW.exposure, 1e-12);
    for (uint i = 0u; i < pc.spp; ++i) {
        vec3 H = oxToWorld(oxSampleGGXVNDF(Vl, alpha, oxRtRandom2(rng)), N);
        vec3 L = reflect(-V, H);
        if (dot(L, N) <= 0.0) L = reflect(L, N);
        RtHit h = oxRtTraceClosest(pc.scene, pc.rt, origin, L, 0.0, 1e4, OX_RT_MASK_ALL);
        vec3 radiance;
        if (h.hit) {
            float lod = oxRtConeLod(h.t, alpha * 0.5 + 0.002, 512.0);
            RtSurface s = oxRtFetchSurface(pc.scene, pc.rt, h.instance, h.primitive, h.bary, L, lod);
            radiance = oxRtShadeHit(pc.view, pc.scene, pc.rt, s, -L, rng, (pc.flags & 1u) != 0u);
        } else {
            radiance = oxRtMissRadiance(pc.view, pc.scene, L, roughness < 0.2);
        }
        float lum = oxLuminance(radiance);
        if (lum > maxLum) radiance *= maxLum / lum;
        sum += radiance;
    }
    float weight = 1.0 - smoothstep(pc.maxRoughness * 0.75, pc.maxRoughness, roughness);
    OX_IMAGE_STORE_2D(rgba16f, pc.outRefl, p, vec4(sum / float(pc.spp), weight));
}
