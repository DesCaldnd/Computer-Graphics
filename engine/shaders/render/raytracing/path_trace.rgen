#version 460
// Reference path tracer, RT pipeline variant (r.PathTracing.Mode 1): same integrator as path_trace.comp
// (path_common.glsl), traversal through traceRayEXT with closest-hit / any-hit (alpha test) / miss shaders.
#include "path_payload.glsl"

layout(location = 0) rayPayloadEXT PtPayload payload;
layout(location = 1) rayPayloadEXT uint shadowVisible;

accelerationStructureEXT ptTlas() { return accelerationStructureEXT(pc.rt.h.tlas); }

RtHit ptTraceClosest(vec3 origin, vec3 dir, float tmax, uint mask) {
    payload.hit = 0u;
    traceRayEXT(ptTlas(), gl_RayFlagsNoneEXT, mask, 0, 2, 0, origin, 0.0, dir, tmax, 0);
    RtHit h;
    h.hit = payload.hit != 0u;
    h.t = payload.t;
    h.instance = payload.instance;
    h.primitive = payload.primitive;
    h.bary = payload.bary;
    return h;
}

// Opaque visibility only in this mode (no coloured transmission through translucent casters).
vec3 ptShadow(vec3 origin, vec3 dir, float tmax) {
    shadowVisible = 0u;
    traceRayEXT(ptTlas(), gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                OX_RT_MASK_SHADOW_OPAQUE, 1, 2, 1, origin, 0.0, dir, tmax, 1);
    return vec3(float(shadowVisible));
}

#include "path_common.glsl"

void main() {
    ivec2 p = ivec2(gl_LaunchIDEXT.xy);
    if (any(greaterThanEqual(p, ivec2(pc.width, pc.height)))) return;
    vec4 acc = pc.reset != 0u ? vec4(0.0) : OX_IMAGE_LOAD_2D(rgba32f, pc.accum, p);
    for (uint s = 0u; s < pc.samples; ++s) {
        uint rng = oxRtSeed(uvec2(p), pc.frame, s);
        vec3 c = ptTracePath(p, rng);
        if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
        acc += vec4(c, 1.0);
    }
    OX_IMAGE_STORE_2D(rgba32f, pc.accum, p, acc);
    OX_IMAGE_STORE_2D(rgba16f, pc.sceneColor, p, vec4(acc.rgb / max(acc.a, 1.0) * VIEW.preExposure, 1.0));
}
