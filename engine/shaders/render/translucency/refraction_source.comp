#version 460
// SceneColorRefraction mip chain + SceneDepthCopy.
//   mode 0: mip 0 = SceneColorHDR (texel copy); also copies Depth into the R32F SceneDepthCopy when depthDst is valid
//   mode 1: mip n = 4×4 binomial (Gaussian approximation) downsample of mip n-1 (storage loads, clamped borders)
//   mode 2: one thread per 2×2 block: mip 0 = SceneColorHDR, mip 1 (depthDst = its storage index) = box average
#include <render/common/view.glsl>

layout(local_size_x = 8, local_size_y = 8) in;

OX_PUSH_CONSTANTS({ uint mode; uint src; uint dst; uint depthSrc; uint depthDst; uint dstWidth; uint dstHeight; uint srcWidth; uint srcHeight; });

const float kW[4] = float[](1.0, 3.0, 3.0, 1.0);

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (pc.mode == 2u) {
        // dst/dstWidth/dstHeight = mip 0, depthDst = mip 1 storage index; threads cover mip 1.
        ivec2 size = ivec2(pc.dstWidth, pc.dstHeight);
        ivec2 halfSize = max(size / 2, ivec2(1));
        if (p.x >= halfSize.x || p.y >= halfSize.y) return;
        vec3 sum = vec3(0.0);
        ivec2 base = p * 2;
        // Odd sizes: the last row/column of mip 0 is copied by the edge threads.
        ivec2 extent = ivec2(p.x == halfSize.x - 1 ? size.x - base.x : 2, p.y == halfSize.y - 1 ? size.y - base.y : 2);
        for (int y = 0; y < extent.y; ++y) {
            for (int x = 0; x < extent.x; ++x) {
                ivec2 q = base + ivec2(x, y);
                vec3 c = OX_FETCH_2D(pc.src, q, 0).rgb;
                OX_IMAGE_STORE_2D(rgba16f, pc.dst, q, vec4(c, 1.0));
                if (x < 2 && y < 2) sum += c;
            }
        }
        if (pc.depthDst != OX_INVALID_INDEX) OX_IMAGE_STORE_2D(rgba16f, pc.depthDst, p, vec4(sum * 0.25, 1.0));
        return;
    }
    if (p.x >= int(pc.dstWidth) || p.y >= int(pc.dstHeight)) return;
    if (pc.mode == 0u) {
        if (pc.src != OX_INVALID_INDEX) OX_IMAGE_STORE_2D(rgba16f, pc.dst, p, vec4(OX_FETCH_2D(pc.src, p, 0).rgb, 1.0));
        if (pc.depthDst != OX_INVALID_INDEX) OX_IMAGE_STORE_2D(r32f, pc.depthDst, p, vec4(OX_FETCH_2D(pc.depthSrc, p, 0).r));
        return;
    }
    ivec2 base = p * 2 - 1;
    ivec2 maxP = ivec2(pc.srcWidth, pc.srcHeight) - 1;
    vec3 sum = vec3(0.0);
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            ivec2 q = clamp(base + ivec2(x, y), ivec2(0), maxP);
            sum += OX_IMAGE_LOAD_2D(rgba16f, pc.src, q).rgb * (kW[x] * kW[y]);
        }
    }
    OX_IMAGE_STORE_2D(rgba16f, pc.dst, p, vec4(sum / 64.0, 1.0));
}
