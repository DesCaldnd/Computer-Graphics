#version 460
// Closest (max reversed-Z) depth of each low-resolution particle texel's footprint in SceneDepthCopy.
#include <render/common/view.glsl>
layout(local_size_x = 8, local_size_y = 8) in;
OX_PUSH_CONSTANTS({ uint src; uint dst; uint scale; uint srcWidth; uint srcHeight; uint dstWidth; uint dstHeight; });
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.dstWidth) || p.y >= int(pc.dstHeight)) return;
    float d = 0.0;
    for (uint y = 0u; y < pc.scale; ++y) {
        for (uint x = 0u; x < pc.scale; ++x) {
            ivec2 q = min(p * int(pc.scale) + ivec2(x, y), ivec2(pc.srcWidth, pc.srcHeight) - 1);
            d = max(d, OX_FETCH_2D(pc.src, q, 0).r);
        }
    }
    OX_IMAGE_STORE_2D(r32f, pc.dst, p, vec4(d));
}
