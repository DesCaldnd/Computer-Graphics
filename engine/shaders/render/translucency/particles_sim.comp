#version 460
// GPU particle simulation, one emitter per dispatch:
//   mode 0 init      dead list = all slots, counters reset
//   mode 1 emit      pop dead slots, initialise from the emitter shape, push to alive[current]
//   mode 2 simulate  age, gravity, drag, curl-noise turbulence, depth-buffer collisions (bounce / kill);
//                    survivors → alive[next], dead → dead list
//   mode 3 finalize  indirect draw args (instanceCount = alive[next]), alive[current] = 0
// Optional back-to-front sorting: particles_sort.comp.
#include "particles_common.glsl"
#include <render/common/view.glsl>

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform OxPushConstants {
    ViewBuffer view;
    SceneBuffer scene;
    EmitterBuffer emitter;
    ParticleBuffer particles;
    ParticleLists lists;
    ParticleCounters counters;
    IndexBufferRef indices;
    uint mode;
    uint sceneDepth; // SceneDepthCopy (OX_INVALID_INDEX = no collisions)
    uint normals;
    uint sortCount;  // particles_sort.comp only
    uint sortK;
    uint sortJ;
} pc;

#define EM pc.emitter.e

void initParticle(uint slot, uint i) {
    uint rng = oxPcg(EM.seed ^ oxPcg(i * 9781u + 17u));
    vec3 pos = vec3(0.0);
    vec3 dir = vec3(0.0, 1.0, 0.0);
    uint shape = uint(EM.shape.x);
    if (shape == 0u) {
        dir = oxRandomUnitVector(rng);
    } else if (shape == 1u) {
        dir = oxRandomUnitVector(rng);
        float r = EM.shape.w > 0.5 ? 1.0 : pow(oxRandom(rng), 1.0 / 3.0);
        pos = dir * EM.shape.y * r;
    } else if (shape == 2u) {
        float cosA = cos(EM.shape.z);
        float z = mix(cosA, 1.0, oxRandom(rng));
        float a = oxRandom(rng) * OX_TWO_PI;
        float s = sqrt(max(1.0 - z * z, 0.0));
        dir = vec3(s * cos(a), z, s * sin(a));
        float rr = sqrt(oxRandom(rng)) * EM.shape.y;
        float b = oxRandom(rng) * OX_TWO_PI;
        pos = vec3(cos(b) * rr, 0.0, sin(b) * rr);
    } else if (shape == 3u) {
        pos = (vec3(oxRandom(rng), oxRandom(rng), oxRandom(rng)) * 2.0 - 1.0) * EM.box.xyz;
    } else if (shape == 4u && EM.meshTriangles > 0u) {
        uint tri = min(uint(oxRandom(rng) * float(EM.meshTriangles)), EM.meshTriangles - 1u);
        uint base = EM.meshFirstIndex + tri * 3u;
        PositionBuffer positions = pc.scene.s.positions;
        vec3 a = positions.p[uint(EM.meshVertexOffset) + pc.indices.i[base]];
        vec3 b = positions.p[uint(EM.meshVertexOffset) + pc.indices.i[base + 1u]];
        vec3 c = positions.p[uint(EM.meshVertexOffset) + pc.indices.i[base + 2u]];
        float u = oxRandom(rng), v = oxRandom(rng);
        if (u + v > 1.0) {
            u = 1.0 - u;
            v = 1.0 - v;
        }
        pos = a + (b - a) * u + (c - a) * v;
        vec3 n = cross(b - a, c - a);
        dir = dot(n, n) > 1e-12 ? normalize(n) : vec3(0.0, 1.0, 0.0);
    }
    Particle p;
    p.position = (EM.world * vec4(pos, 1.0)).xyz;
    vec3 wdir = mat3(EM.world) * dir;
    wdir = dot(wdir, wdir) > 1e-12 ? normalize(wdir) : vec3(0.0, 1.0, 0.0);
    p.velocity = wdir * mix(EM.lifetime.z, EM.lifetime.w, oxRandom(rng)) + EM.velocity.xyz;
    p.age = 0.0;
    p.lifetime = max(mix(EM.lifetime.x, EM.lifetime.y, oxRandom(rng)), 1e-3);
    p.size = mix(EM.size.x, EM.size.y, oxRandom(rng));
    p.rotation = mix(EM.size.z, EM.size.w, oxRandom(rng));
    p.rotationSpeed = mix(EM.rotation.x, EM.rotation.y, oxRandom(rng));
    float frames = max(EM.flipbook.x * EM.flipbook.y, 1.0);
    p.frameOffset = EM.flipbook.w > 0.5 ? floor(oxRandom(rng) * frames) : 0.0;
    p.seed = rng;
    p.pad0 = 0u;
    p.pad1 = 0.0;
    p.pad2 = 0.0;
    pc.particles.p[slot] = p;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint maxP = EM.maxParticles;
    uint cur = EM.current;
    uint nxt = cur ^ 1u;
    uint aliveBase = maxP * (1u + cur);
    uint nextBase = maxP * (1u + nxt);

    if (pc.mode == 0u) {
        if (i < maxP) {
            pc.lists.v[i] = i;
            pc.particles.p[i].lifetime = 0.0;
        }
        if (i == 0u) {
            pc.counters.c[0] = int(maxP);
            pc.counters.c[1] = 0;
            pc.counters.c[2] = 0;
            for (int k = 4; k < 16; ++k) pc.counters.c[k] = 0;
        }
        return;
    }
    if (pc.mode == 1u) {
        if (i >= EM.emitCount) return;
        int d = atomicAdd(pc.counters.c[0], -1) - 1;
        if (d < 0) {
            atomicAdd(pc.counters.c[0], 1);
            return;
        }
        uint slot = pc.lists.v[uint(d)];
        initParticle(slot, i);
        int a = atomicAdd(pc.counters.c[1 + int(cur)], 1);
        pc.lists.v[aliveBase + uint(a)] = slot;
        return;
    }
    if (pc.mode == 2u) {
        int aliveCount = min(pc.counters.c[1 + int(cur)], int(maxP));
        if (i >= uint(aliveCount)) return;
        uint slot = pc.lists.v[aliveBase + i];
        Particle p = pc.particles.p[slot];
        float dt = EM.turbulence.w;
        p.age += dt;
        bool dead = p.age >= p.lifetime;
        if (!dead) {
            vec3 acc = EM.gravity.xyz;
            if (EM.gravity.w > 0.0) {
                acc += oxCurl(p.position * EM.turbulence.x, EM.turbulence.z * EM.turbulence.y) * EM.gravity.w;
            }
            p.velocity += acc * dt;
            p.velocity *= exp(-EM.velocity.w * dt);
            vec3 newPos = p.position + p.velocity * dt;
            // Depth buffer collision.
            uint mode = uint(EM.collision.x);
            if (mode != 0u && pc.sceneDepth != OX_INVALID_INDEX) {
                float ndcZ;
                vec2 uv = oxProjectToUv(pc.view.v.viewProj, newPos, ndcZ);
                if (all(greaterThan(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0))) && ndcZ > 0.0 && ndcZ < 1.0) {
                    float sd = OX_SAMPLE_2D_LOD(pc.sceneDepth, OX_SAMPLER_NEAREST_CLAMP, uv, 0.0).r;
                    if (sd > 0.0) {
                        float sceneLin = oxLinearDepth(pc.view, sd);
                        float pLin = oxLinearDepth(pc.view, ndcZ);
                        float thickness = 0.3 + length(p.velocity) * dt * 2.0;
                        if (pLin > sceneLin && pLin - sceneLin < thickness) {
                            if (mode == 2u) {
                                dead = true;
                            } else {
                                vec3 n = pc.normals != OX_INVALID_INDEX
                                             ? OX_SAMPLE_2D_LOD(pc.normals, OX_SAMPLER_NEAREST_CLAMP, uv, 0.0).xyz
                                             : vec3(0.0, 1.0, 0.0);
                                n = dot(n, n) > 1e-6 ? normalize(n) : vec3(0.0, 1.0, 0.0);
                                float vn = dot(p.velocity, n);
                                if (vn < 0.0) {
                                    vec3 vt = p.velocity - vn * n;
                                    p.velocity = vt * (1.0 - EM.collision.z) - vn * n * EM.collision.y;
                                }
                                vec3 surface = oxWorldPositionFromDepth(pc.view, uv, sd);
                                newPos = surface + n * 0.01;
                            }
                        }
                    }
                }
            }
            p.position = newPos;
            p.rotation += p.rotationSpeed * dt;
        }
        if (dead) {
            p.lifetime = 0.0;
            pc.particles.p[slot] = p;
            int d = atomicAdd(pc.counters.c[0], 1);
            pc.lists.v[uint(d)] = slot;
        } else {
            pc.particles.p[slot] = p;
            int a = atomicAdd(pc.counters.c[1 + int(nxt)], 1);
            pc.lists.v[nextBase + uint(a)] = slot;
        }
        return;
    }
    if (pc.mode == 3u) {
        if (i != 0u) return;
        int alive = pc.counters.c[1 + int(nxt)];
        pc.counters.c[1 + int(cur)] = 0;
        // VkDrawIndirectCommand: 6 vertices per billboard quad.
        pc.counters.c[4] = 6;
        pc.counters.c[5] = alive;
        pc.counters.c[6] = 0;
        pc.counters.c[7] = 0;
        // VkDrawIndexedIndirectCommand for mesh particles.
        pc.counters.c[8] = int(EM.meshIndexCount);
        pc.counters.c[9] = alive;
        pc.counters.c[10] = int(EM.meshFirstIndex);
        pc.counters.c[11] = EM.meshVertexOffset;
        pc.counters.c[12] = 0;
        return;
    }
}
