#version 460
// Bakes the 32³ colour grading LUT (RGBA16F 3D). Input coordinates are log2-encoded exposed scene values
// (mid grey 0.18 at the same position as AgX's encoding: −12.47 … +4.03 EV around it), outputs linear exposed values.
// Order: white balance (von Kries/CAT02 matrix from the CPU) → contrast around mid grey in log space → saturation →
// lift / gamma / gain.
#include <render/postprocess/grading_common.glsl>

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

OX_PUSH_CONSTANTS({
    uint dst;
    uint size;
    mat3 whiteBalance; // linear Rec.709 → linear Rec.709
    float saturation;
    float contrast;
    vec3 lift;
    vec3 gamma;
    vec3 gain;
});

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id, uvec3(pc.size)))) return;
    vec3 t = vec3(id) / float(pc.size - 1u);
    vec3 x = gradingLutDecode(t);
    x = max(pc.whiteBalance * x, vec3(0.0));
    vec3 lx = log2(max(x, vec3(1e-10)));
    lx = (lx - kGradingMidGreyLog) * pc.contrast + kGradingMidGreyLog;
    x = exp2(lx);
    float luma = dot(x, vec3(0.2126, 0.7152, 0.0722));
    x = max(mix(vec3(luma), x, pc.saturation), vec3(0.0));
    // Lift raises the shadows (fades out above 1), gain scales, gamma bends the mid-tones.
    x = x * pc.gain + pc.lift * (1.0 - clamp(x, 0.0, 1.0));
    x = pow(max(x, vec3(0.0)), 1.0 / max(pc.gamma, vec3(0.01)));
    imageStore(oxImages3D_rgba16f[nonuniformEXT(pc.dst)], ivec3(id), vec4(x, 1.0));
}
