// Input: EASU output in tonemapped (perceptual) space; output: linear pre-exposed HDR (inverse tonemap).
#include <render/postprocess/pp_common.glsl>

layout(local_size_x = 8, local_size_y = 8) in;

OX_PUSH_CONSTANTS({
    uint src;
    uint dst;
    float sharpnessStops; // 0 = maximum sharpness, each stop halves it
    uint pad;
    vec2 size;
});

const float kRcasLimit = 0.25 - 1.0 / 16.0;

vec3 tap(ivec2 p) {
    p = clamp(p, ivec2(0), ivec2(pc.size) - 1);
    return OX_FETCH_2D(pc.src, p, 0).rgb;
}
float lumaOf(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.size)))) return;
    //    b
    //  d e f
    //    h
    vec3 b = tap(p + ivec2(0, -1));
    vec3 d = tap(p + ivec2(-1, 0));
    vec3 e = tap(p);
    vec3 f = tap(p + ivec2(1, 0));
    vec3 h = tap(p + ivec2(0, 1));
    float bL = lumaOf(b), dL = lumaOf(d), eL = lumaOf(e), fL = lumaOf(f), hL = lumaOf(h);
    // Noise detection: dampen sharpening of isolated noisy pixels.
    float nz = 0.25 * bL + 0.25 * dL + 0.25 * fL + 0.25 * hL - eL;
    float range = max(max(max(bL, dL), max(eL, fL)), hL) - min(min(min(bL, dL), min(eL, fL)), hL);
    nz = clamp(abs(nz) / max(range, 1e-6), 0.0, 1.0);
    nz = -0.5 * nz + 1.0;
    vec3 mn4 = min(min(b, d), min(f, h));
    vec3 mx4 = max(max(b, d), max(f, h));
    // Limiters: the largest negative lobe that keeps the result inside [0, 1].
    vec2 peakC = vec2(1.0, -4.0);
    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, 1e-6);
    vec3 hitMax = (peakC.x - max(mx4, e)) / min(4.0 * mn4 + peakC.y, -1e-6);
    vec3 lobeRGB = max(-hitMin, hitMax);
    float lobe = max(-kRcasLimit, min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) * exp2(-pc.sharpnessStops);
    lobe *= nz;
    float rcpL = 1.0 / (4.0 * lobe + 1.0);
    vec3 pix = (lobe * b + lobe * d + lobe * h + lobe * f + e) * rcpL;
    OX_IMAGE_STORE_2D(rgba16f, pc.dst, p, vec4(ppTonemapInverse(clamp(pix, 0.0, 0.9998)), 1.0));
}
