#version 460
// Bloom upsample: 3×3 tent filter of the smaller level added to this level's downsample. The final level is
// multiplied by 1 / levels, so the bloom image is the average of all blur scales (energy conserving).
#include <render/postprocess/pp_common.glsl>

layout(local_size_x = 8, local_size_y = 8) in;

OX_PUSH_CONSTANTS({
    uint low;     // smaller upsampled level (or the smallest downsample)
    uint current; // downsample of this level
    uint dst;
    float scale;
    vec2 lowTexel;
    vec2 dstSize;
});

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.dstSize)))) return;
    vec2 uv = (vec2(p) + 0.5) / pc.dstSize;
    vec2 t = pc.lowTexel;
    vec3 sum = vec3(0.0);
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv + vec2(-t.x, -t.y), 0.0).rgb;
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv + vec2(0.0, -t.y), 0.0).rgb * 2.0;
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv + vec2(t.x, -t.y), 0.0).rgb;
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv + vec2(-t.x, 0.0), 0.0).rgb * 2.0;
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv, 0.0).rgb * 4.0;
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv + vec2(t.x, 0.0), 0.0).rgb * 2.0;
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv + vec2(-t.x, t.y), 0.0).rgb;
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv + vec2(0.0, t.y), 0.0).rgb * 2.0;
    sum += OX_SAMPLE_2D_LOD(pc.low, OX_SAMPLER_LINEAR_CLAMP, uv + vec2(t.x, t.y), 0.0).rgb;
    vec3 cur = OX_FETCH_2D(pc.current, p, 0).rgb;
    OX_IMAGE_STORE_2D(rgba16f, pc.dst, p, vec4((cur + sum / 16.0) * pc.scale, 1.0));
}
