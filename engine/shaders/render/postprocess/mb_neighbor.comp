#version 460
// Motion blur 2/3: neighbour max — the longest tile velocity in the 3×3 tile neighbourhood.
#include <render/postprocess/pp_common.glsl>

layout(local_size_x = 8, local_size_y = 8) in;

OX_PUSH_CONSTANTS({
    uint src;
    uint dst;
    vec2 tileCount;
});

void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(t, ivec2(pc.tileCount)))) return;
    vec2 best = vec2(0.0);
    float bestLen = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 q = clamp(t + ivec2(x, y), ivec2(0), ivec2(pc.tileCount) - 1);
            vec2 v = OX_FETCH_2D(pc.src, q, 0).rg;
            float l = dot(v, v);
            if (l > bestLen) {
                bestLen = l;
                best = v;
            }
        }
    }
    OX_IMAGE_STORE_2D(rg16f, pc.dst, t, vec4(best, 0.0, 0.0));
}
