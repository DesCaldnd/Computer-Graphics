#version 460
// HDR post composite at output resolution (before the core tonemapper):
//   lateral chromatic aberration → bloom (energy conserving lerp) + lens dirt → vignette (cos⁴-like falloff) →
//   white balance / grading LUT (32³, log space, on exposed values; converted back to pre-exposed units).
#include <render/postprocess/grading_common.glsl>

layout(local_size_x = 8, local_size_y = 8) in;

OX_PUSH_CONSTANTS({
    ViewBuffer view;
    uint src;
    uint bloom;        // OX_INVALID_INDEX = none
    uint dirt;         // OX_INVALID_INDEX = none
    uint lut;          // 3D, OX_INVALID_INDEX = none
    uint exposureTex;  // 1×1 R32F, OX_INVALID_INDEX = VIEW.exposure
    uint dst;
    float bloomIntensity;
    float dirtIntensity;
    float vignette;
    float chromatic;
    float lutSize;
    uint pad;
    vec2 size;
});

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.size)))) return;
    vec2 uv = (vec2(p) + 0.5) / pc.size;
    vec2 fromCenter = uv - 0.5;
    vec3 c;
    if (pc.chromatic > 0.0) {
        // Red refracts less, blue more: radial shift growing with the distance from the optical centre.
        vec2 shift = fromCenter * dot(fromCenter, fromCenter) * pc.chromatic * 0.04;
        c.r = OX_SAMPLE_2D_LOD(pc.src, OX_SAMPLER_LINEAR_CLAMP, uv - shift, 0.0).r;
        c.g = OX_FETCH_2D(pc.src, p, 0).g;
        c.b = OX_SAMPLE_2D_LOD(pc.src, OX_SAMPLER_LINEAR_CLAMP, uv + shift, 0.0).b;
    } else {
        c = OX_FETCH_2D(pc.src, p, 0).rgb;
    }
    c = ppSanitize(c);
    if (pc.bloom != OX_INVALID_INDEX) {
        vec3 b = OX_SAMPLE_2D_LOD(pc.bloom, OX_SAMPLER_LINEAR_CLAMP, uv, 0.0).rgb;
        c = mix(c, b, pc.bloomIntensity);
        if (pc.dirt != OX_INVALID_INDEX) {
            vec3 d = OX_SAMPLE_2D_LOD(pc.dirt, OX_SAMPLER_LINEAR_CLAMP, uv, 0.0).rgb;
            c += b * d * pc.dirtIntensity * pc.bloomIntensity;
        }
    }
    if (pc.vignette > 0.0) {
        float aspect = pc.size.x / pc.size.y;
        vec2 v = fromCenter * vec2(aspect, 1.0) / length(vec2(aspect, 1.0) * 0.5); // 1 at the corners
        float k = pc.vignette * 1.4;
        float r2 = dot(v, v) * k * k;
        c *= 1.0 / ((1.0 + r2) * (1.0 + r2));
    }
    if (pc.lut != OX_INVALID_INDEX) {
        float preExposure = max(pc.view.v.preExposure, 1e-12);
        float exposure = pc.exposureTex != OX_INVALID_INDEX ? OX_FETCH_2D(pc.exposureTex, ivec2(0), 0).r
                                                            : pc.view.v.exposure;
        float toExposed = exposure / preExposure;
        c = gradingApply(pc.lut, pc.lutSize, c * toExposed) / max(toExposed, 1e-12);
    }
    OX_IMAGE_STORE_2D(rgba16f, pc.dst, p, vec4(ppSanitize(c), 1.0));
}
